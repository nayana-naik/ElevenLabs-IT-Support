# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# ---- ElevenLabs ----
# Get this from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Fill these in AFTER creating the 4 agents in the ElevenLabs dashboard (see agents/README.md)
AGENT_1_VERIFICATION_ID=
AGENT_2_BILLING_ID=
AGENT_3_TECH_SUPPORT_ID=
AGENT_4_ESCALATION_ID=

# ---- n8n ----
# Base URL of your n8n instance (local: http://localhost:5678/webhook, or your n8n cloud webhook URL)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# ---- Twilio (OPTIONAL - only needed if you skip ElevenLabs' built-in "Import from Twilio") ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
